# Supabase (production persistence + auth). Leave both unset to run on the
# local JSON file store with the development cookie session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional overrides
# NEXT_PUBLIC_PRODUCT_NAME=رحلتنا
# NEXT_PUBLIC_DEFAULT_CURRENCY=SAR
# DATA_FILE=.data/store.json

# Trusted server access (Vercel only, never NEXT_PUBLIC_). With it set, the app
# reads and writes households with explicit identity filters and clients get no
# direct table access (see supabase/migrations/PENDING_lock_direct_table_access.sql).
SUPABASE_SERVICE_ROLE_KEY=
